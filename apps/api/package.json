    "dotenv": "18.0.10",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "temporal-polyfill": "1.0.4"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.12",
    "@nestjs/schematics": "12.0.13",
    "@nestjs/testing": "12.5.0",
    "@prisma/cli-engine": "0.9.0",
    "@types/node": "22.20.5",
    "prisma": "8.0.0-rc.33",
    "typescript": "6.0.3"
